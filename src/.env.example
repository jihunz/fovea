# Folder that contains your datasets. It is mounted at /host inside the container and
# host-style paths (e.g. /Users/me/datasets/foo or C:\data\foo) are mapped automatically.
# Mac/Linux: HOST_PATH=/Users/me/datasets
# Windows:   HOST_PATH=C://Users/Administrator/datasets
HOST_PATH=/Users/jihunjang/Downloads

# Your user and group id (Linux: `id -u` / `id -g`), so files Fovea writes into HOST_PATH stay owned by you.
# UID=1000
# GID=1000

# Opening Fovea to other machines (docker-compose.yml binds 127.0.0.1 only): require this token from them.
# FOVEA_TOKEN=change-me
